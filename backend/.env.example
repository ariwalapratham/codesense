# Required for embeddings and chat
GEMINI_API_KEY=

# Optional — defaults match backend/config/settings.py
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_LLM_FALLBACK_MODEL=gemini-2.5-flash-lite

# MongoDB (start locally or use Atlas connection string)
MONGODB_URL=mongodb://localhost:27017
DB_NAME=codesense

# Paths relative to backend/ when running uvicorn from backend/
TEMP_REPOS_PATH=../temp_repos

# CORS — browser origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Qdrant Cloud (leave URL empty for in-memory store; required for persist)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=codesense_chunks

# Ingest size limits (413 repo_too_large if the GitHub-reported size exceeds this)
MAX_REPO_SIZE_MB=50
MAX_FILE_SIZE_KB=256
# Set false in tests so TestClient does not claim leftover jobs
INGESTION_WORKER_ENABLED=true

# Auth — GitHub OAuth + JWT. JWT_SECRET is required to sign tokens (min 32 chars).
JWT_SECRET=your-very-strong-secret-key-here
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_REFRESH_COOKIE_NAME=codesense_refresh
# Local HTTP: secure=false, samesite=lax. Prod cross-site (Vercel+Render): true / none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Optional — private GitHub/GitLab repos
GITHUB_TOKEN=
GITLAB_TOKEN=
